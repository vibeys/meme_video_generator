# Create a Reddit app that is approved for Data API access, then paste its values here.
# Keep this file private. Never upload your real .env file to GitHub.
REDDIT_CLIENT_ID=put_your_client_id_here
REDDIT_CLIENT_SECRET=put_your_client_secret_here
REDDIT_USERNAME=your_reddit_username

# Optional descriptive application label used in the Reddit User-Agent.
APP_NAME=local-meme-video-generator
APP_VERSION=1.0.0
